---
import { Image } from 'astro:assets';
import imobiShot from '../assets/imobi-preview.png';
import retroShot from '../assets/retroyrd-preview.png';
import { type Lang, defaultLang } from '../i18n/ui';

interface Props {
  lang?: Lang;
}

const { lang = defaultLang } = Astro.props;

const copy = {
  pt: {
    whoami: 'whoami',
    who: 'Matheus Yared · engenheiro de software · Curitiba/PR',
    title: 'Software sob medida para a operação que você já tem.',
    lead: 'Desenvolvo sistemas, integrações e infraestrutura sob encomenda para empresas, do portal que vende ao banco de dados que não pode parar. Escopo claro, entrega em produção e código que fica com você.',
    cta: 'Solicitar orçamento',
    cta2: 'Ver serviços',
    quote: 'Fez um trabalho muito importante em um de nossos clientes, com bastante relevância.',
    quoteBy: 'Rodrigo Mastini · SR IT Operation Manager',
    live: 'no ar',
    viewCase: 'ver o caso',
    shots: [
      { slug: 'imobi', tab: 'imobi', url: 'fariasdourado.com.br', kind: 'feito para cliente', caption: 'Portal imobiliário em produção', alt: 'Tela inicial do portal imobiliário Farias Dourado, com busca de imóveis e imóveis em destaque' },
      { slug: 'retroyrd', tab: 'retroyrd', url: 'retro.yared.com.br', kind: 'produto próprio', caption: 'Retrospectivas ágeis em tempo real', alt: 'Tela do Retroyrd, plataforma de retrospectivas ágeis em tempo real' },
    ],
    proofTitle: 'em produção',
    stats: [
      { value: '6 TB', label: 'migrados para a GCP', sub: 'ERP crítico, com integridade verificada bit a bit.', slug: 'gcp-migration-6tb' },
      { value: '<20 MB', label: 'de RAM por aplicação', sub: 'Ferramentas em Rust rodando em infraestrutura própria.', slug: 'retroyrd' },
      { value: '95+', label: 'no PageSpeed', sub: 'Portal imobiliário com carregamento abaixo de um segundo.', slug: 'imobi' },
    ],
  },
  en: {
    whoami: 'whoami',
    who: 'Matheus Yared · software engineer · Curitiba, Brazil',
    title: 'Custom software for the operation you already run.',
    lead: 'I build systems, integrations and infrastructure to order for companies, from the portal that sells to the database that cannot stop. Clear scope, delivery in production, and code that stays with you.',
    cta: 'Request a quote',
    cta2: 'See services',
    quote: 'He did very important work for one of our clients, with real relevance.',
    quoteBy: 'Rodrigo Mastini · SR IT Operation Manager',
    live: 'live',
    viewCase: 'view the case',
    shots: [
      { slug: 'imobi', tab: 'imobi', url: 'fariasdourado.com.br', kind: 'built for a client', caption: 'Real estate portal in production', alt: 'Home screen of the Farias Dourado real estate portal, with property search and featured listings' },
      { slug: 'retroyrd', tab: 'retroyrd', url: 'retro.yared.com.br', kind: 'own product', caption: 'Real-time agile retrospectives', alt: 'Screen of Retroyrd, a real-time agile retrospective platform' },
    ],
    proofTitle: 'in production',
    stats: [
      { value: '6 TB', label: 'migrated to GCP', sub: 'Mission-critical ERP, with integrity verified bit by bit.', slug: 'gcp-migration-6tb' },
      { value: '<20 MB', label: 'of RAM per application', sub: 'Rust tools running on self-hosted infrastructure.', slug: 'retroyrd' },
      { value: '95+', label: 'PageSpeed score', sub: 'Real estate portal loading in under a second.', slug: 'imobi' },
    ],
  },
};
const c = copy[lang] || copy.pt;
const images = { imobi: imobiShot, retroyrd: retroShot } as const;
---

<section class="pb-16 md:pb-20">
  <div class="grid items-center gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,27rem)] lg:gap-12">
    <div>
      <p class="prompt mb-2">{c.whoami}</p>
      <p class="mb-8 font-mono text-xs text-zinc-400">{c.who}</p>

      <h1 class="text-[2rem] font-semibold leading-[1.1] text-zinc-50 sm:text-4xl md:text-5xl">
        {c.title}<span class="hero-caret" aria-hidden="true">_</span>
      </h1>

      <p class="mt-6 max-w-xl text-base leading-relaxed text-zinc-400 md:text-lg">
        {c.lead}
      </p>

      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a href="#contato" id="hero-cta-orcamento" class="btn-tui">
          <span>{c.cta}</span>
          <span aria-hidden="true">↵</span>
        </a>
        <a href={`/${lang}/servicos/`} id="hero-cta-servicos" class="btn-ghost">
          <span>{c.cta2}</span>
          <span aria-hidden="true">→</span>
        </a>
      </div>

      <figure class="mt-8 max-w-xl border-l-2 border-term-line pl-4">
        <blockquote class="text-sm leading-relaxed text-zinc-300">“{c.quote}”</blockquote>
        <figcaption class="mt-1.5 font-mono text-[11px] text-term-dim">{c.quoteBy}</figcaption>
      </figure>
    </div>

    <!-- Vitrine: telas reais de sistemas em produção, alternando entre as abas -->
    <div class="tui-win showcase" data-showcase>
      <div class="tui-bar !gap-2 !pr-1">
        <span class="tui-dots" aria-hidden="true"><i></i><i></i><i></i></span>
        <div class="flex min-w-0 flex-1 items-center gap-1 pl-1" role="tablist" aria-label={c.proofTitle}>
          {c.shots.map((s, i) => (
            <button
              type="button"
              role="tab"
              id={`shot-tab-${s.slug}`}
              aria-selected={i === 0 ? 'true' : 'false'}
              aria-controls={`shot-${s.slug}`}
              tabindex={i === 0 ? 0 : -1}
              class="showcase-tab"
            >{s.tab}</button>
          ))}
        </div>
        <span class="tui-meta flex items-center gap-1.5 pr-2 text-term-green">
          <span class="h-1.5 w-1.5 rounded-full bg-term-green" aria-hidden="true"></span>{c.live}
        </span>
      </div>
      <div class="showcase-stage">
        {c.shots.map((s, i) => (
          <a
            href={`/${lang}/projects/${s.slug}/`}
            id={`shot-${s.slug}`}
            role="tabpanel"
            aria-labelledby={`shot-tab-${s.slug}`}
            class="showcase-panel"
            data-active={i === 0 ? '' : undefined}
            hidden={i !== 0}
          >
            <Image src={images[s.slug as keyof typeof images]} alt={s.alt} widths={[480, 864]} sizes="(min-width: 1024px) 27rem, 100vw" loading={i === 0 ? 'eager' : 'lazy'} class="showcase-img" />
            <span class="tui-status">
              <span class="min-w-0 truncate"><span class="text-zinc-200">{s.url}</span> · {s.kind}</span>
              <span class="shrink-0 whitespace-nowrap text-zinc-300">{c.viewCase} <span aria-hidden="true">→</span></span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </div>

  <!-- Provas: números que já constam nos estudos de caso -->
  <div class="tui-win mt-14">
    <div class="tui-bar">
      <span class="tui-dots" aria-hidden="true"><i></i><i></i><i></i></span>
      <span class="tui-title">{c.proofTitle}</span>
    </div>
    <div class="grid divide-y divide-term-line md:grid-cols-3 md:divide-x md:divide-y-0">
      {c.stats.map((s) => (
        <a href={`/${lang}/projects/${s.slug}/`} class="group block p-5 transition-colors hover:bg-zinc-900/60 md:p-6">
          <div class="flex items-baseline gap-2">
            <span class="font-mono text-3xl font-semibold tracking-tight text-zinc-50">{s.value}</span>
            <span class="font-mono text-xs text-term-green">{s.label}</span>
          </div>
          <p class="mt-2 text-sm leading-relaxed text-zinc-400">{s.sub}</p>
          <span class="mt-3 inline-block font-mono text-[11px] text-term-dim group-hover:text-zinc-200">
            {lang === 'pt' ? 'ver o caso' : 'view the case'} <span aria-hidden="true">→</span>
          </span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .showcase-tab {
    padding: 0.3rem 0.55rem;
    border-radius: 3px;
    color: var(--color-term-dim);
    cursor: pointer;
  }
  .showcase-tab:hover { color: var(--color-zinc-100); }
  .showcase-tab[aria-selected='true'] {
    background: var(--color-zinc-800);
    color: var(--color-zinc-50);
  }
  .showcase-stage { display: grid; }
  .showcase-panel {
    grid-area: 1 / 1;
    display: flex;
    flex-direction: column;
  }
  .showcase-panel[hidden] { display: none; }
  .showcase-panel :global(.showcase-img) {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: top;
  }
  .showcase-panel .tui-status { border-top: 1px solid var(--color-term-line); flex-wrap: nowrap; }
  @media (prefers-reduced-motion: no-preference) {
    .showcase-panel[data-active] { animation: showcase-in 0.35s ease-out; }
    @keyframes showcase-in {
      from { opacity: 0; }
      to { opacity: 1; }
    }
  }

  .hero-caret {
    margin-left: 0.15em;
    color: var(--color-term-green);
    font-weight: 400;
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero-caret {
      animation: hero-blink 1.1s steps(1, end) infinite;
    }
    @keyframes hero-blink {
      50% { opacity: 0; }
    }
  }
</style>

<script>
  // Abas da vitrine: clique ou setas trocam a tela; sozinha, alterna a cada 7 s
  // (pausa com o mouse em cima, com foco dentro ou com "reduzir movimento").
  document.querySelectorAll<HTMLElement>('[data-showcase]').forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[role="tabpanel"]')];
    let current = 0;
    let paused = false;

    const show = (i: number, focus = false) => {
      current = (i + tabs.length) % tabs.length;
      tabs.forEach((t, k) => {
        t.setAttribute('aria-selected', String(k === current));
        t.tabIndex = k === current ? 0 : -1;
      });
      panels.forEach((p, k) => {
        p.hidden = k !== current;
        p.toggleAttribute('data-active', k === current);
      });
      if (focus) tabs[current].focus();
    };

    tabs.forEach((t, i) => {
      t.addEventListener('click', () => show(i));
      t.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight') show(current + 1, true);
        if (e.key === 'ArrowLeft') show(current - 1, true);
      });
    });
    root.addEventListener('mouseenter', () => (paused = true));
    root.addEventListener('mouseleave', () => (paused = false));
    root.addEventListener('focusin', () => (paused = true));
    root.addEventListener('focusout', () => (paused = false));

    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      setInterval(() => { if (!paused && !document.hidden) show(current + 1); }, 7000);
    }
  });
</script>
