---
import { type Lang, defaultLang, useTranslations } from '../i18n/ui';

interface Props {
  lang?: Lang;
}

const { lang = defaultLang } = Astro.props;
const t = useTranslations(lang);
const overline = t('hero.overline');
---
<section class="pb-16 md:pb-24 border-b border-zinc-800/40">
  <!-- Overline Tag -->
  <div class="inline-flex items-center gap-2 text-xs font-mono tracking-widest text-zinc-500 uppercase mb-6">
    <span class="w-1.5 h-1.5 bg-zinc-500 rounded-none inline-block"></span>
    <span class="hero-type" style={`--n:${overline.length}`}>{overline}</span>
  </div>

  <!-- Headline -->
  <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-sans font-semibold tracking-tight text-zinc-50 max-w-4xl leading-[1.15]">
    {t('hero.title_start')} <span class="text-zinc-100 font-semibold">{t('hero.title_highlight')}</span> {t('hero.title_end')}
  </h1>

  <!-- Subtitle -->
  <p class="mt-6 text-base md:text-lg text-zinc-400 max-w-2xl font-sans leading-relaxed">
    {t('hero.lead')}
  </p>

  <!-- CTAs -->
  <div class="flex flex-wrap items-center gap-4 mt-8 mb-14">
    <a
      href="#consultoria"
      id="hero-cta-diagnostico"
      class="inline-flex items-center gap-2 px-5 py-2.5 bg-zinc-100 text-zinc-950 text-sm font-semibold rounded hover:bg-white transition-colors"
    >
      <span>{t('hero.cta_consulting')}</span>
      <span aria-hidden="true">&nearr;</span>
    </a>
    <a
      href={`/${lang}/trajetoria/`}
      id="hero-cta-trajetoria"
      class="inline-flex items-center gap-2 px-4 py-2.5 text-zinc-400 hover:text-zinc-100 text-sm font-medium transition-colors"
    >
      <span>{t('hero.cta_trajectory')}</span>
      <span aria-hidden="true">&rarr;</span>
    </a>
  </div>

  <!-- Metrics Row (Quiet, clean hairline 3-column block) -->
  <div class="grid grid-cols-1 md:grid-cols-3 border border-zinc-800/60 bg-zinc-900/70 divide-y md:divide-y-0 md:divide-x divide-zinc-800/60">
    <div class="p-6 flex flex-col justify-between">
      <div class="text-[11px] font-mono uppercase tracking-wider text-zinc-500 mb-2">
        {t('hero.stat_years_label')}
      </div>
      <div class="text-3xl font-semibold text-zinc-100 tracking-tight mb-2">
        {t('hero.stat_years_value')}
      </div>
      <p class="text-xs text-zinc-400 font-sans leading-relaxed">
        {t('hero.stat_years_sub')}
      </p>
    </div>

    <div class="p-6 flex flex-col justify-between">
      <div class="text-[11px] font-mono uppercase tracking-wider text-zinc-500 mb-2">
        {t('hero.stat_scale_label')}
      </div>
      <div class="text-3xl font-semibold text-zinc-100 tracking-tight mb-2">
        {t('hero.stat_scale_value')}
      </div>
      <p class="text-xs text-zinc-400 font-sans leading-relaxed">
        {t('hero.stat_scale_sub')}
      </p>
    </div>

    <div class="p-6 flex flex-col justify-between">
      <div class="text-[11px] font-mono uppercase tracking-wider text-zinc-500 mb-2">
        {t('hero.stat_focus_label')}
      </div>
      <div class="text-3xl font-semibold text-zinc-100 tracking-tight mb-2">
        {t('hero.stat_focus_value')}
      </div>
      <p class="text-xs text-zinc-400 font-sans leading-relaxed">
        {t('hero.stat_focus_sub')}
      </p>
    </div>
  </div>
</section>

<style>
  /* Digita a linha de overline uma vez. O texto fica no HTML (SEO/leitores de tela) e é
     visível por padrão: a animação só o recorta enquanto roda (fill-mode both), então se
     ela não executar o texto continua legível. Respeita "reduzir movimento". */
  @media (prefers-reduced-motion: no-preference) and (min-width: 640px) {
    .hero-type {
      display: inline-block;
      animation: hero-type calc(var(--n) * 36ms) steps(var(--n), end) 0.5s both;
    }
    @keyframes hero-type {
      from { clip-path: inset(0 100% 0 0); }
      to { clip-path: inset(0 0 0 0); }
    }
  }
</style>
