---
import { type Lang, defaultLang, useTranslations } from '../i18n/ui';
import Window from './Window.astro';
import SectionHead from './SectionHead.astro';

interface Props {
  lang?: Lang;
}

const { lang = defaultLang } = Astro.props;
const t = useTranslations(lang);

const symptoms = [
  {
    code: '01',
    title: t('triage.s1_title'),
    desc: t('triage.s1_desc'),
    tag: lang === 'pt' ? 'Bancos de Dados' : 'Databases',
  },
  {
    code: '02',
    title: t('triage.s2_title'),
    desc: t('triage.s2_desc'),
    tag: lang === 'pt' ? 'Migrações & Nuvem' : 'Cloud & Migrations',
  },
  {
    code: '03',
    title: t('triage.s3_title'),
    desc: t('triage.s3_desc'),
    tag: lang === 'pt' ? 'Escalabilidade' : 'Scalability',
  },
  {
    code: '04',
    title: t('triage.s4_title'),
    desc: t('triage.s4_desc'),
    tag: lang === 'pt' ? 'Custos & Infra' : 'FinOps & Infra',
  },
];
---

<section class="py-16 md:py-20 border-b border-term-line scroll-mt-20" id="diagnostico">
  <SectionHead label={lang === 'pt' ? 'SINTOMAS' : 'SYMPTOMS'} title={t('triage.title')} desc={t('triage.lead')} />

  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    {symptoms.map((symptom) => (
      <Window
        as="article"
        title={`${lang === 'pt' ? 'sintoma' : 'symptom'}/${symptom.code}`}
        meta={symptom.tag}
      >
        <h3 class="text-base md:text-lg font-semibold text-zinc-100 mb-2 flex gap-2">
          <span class="text-term-orange font-mono shrink-0" aria-hidden="true">WARN</span>
          <span class="min-w-0">{symptom.title}</span>
        </h3>
        <p class="text-sm text-zinc-400 leading-relaxed">{symptom.desc}</p>
      </Window>
    ))}
  </div>

  <Window title={lang === 'pt' ? 'diagnostico' : 'diagnosis'} class="mt-4">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
      <div class="max-w-2xl">
        <div class="text-xs font-mono text-term-dim uppercase tracking-wider mb-1.5">
          {lang === 'pt' ? 'Proposta de Intervenção Técnica' : 'Technical Engagement Value'}
        </div>
        <p class="text-sm md:text-base text-zinc-300 leading-relaxed">
          {t('triage.bottom_pitch')}
        </p>
      </div>
      <div class="shrink-0">
        <a href="#contato" id="triage-cta-btn" class="btn-tui">
          <span>{t('triage.cta_btn')}</span>
          <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </div>
  </Window>
</section>
