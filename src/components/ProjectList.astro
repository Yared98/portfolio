---
import { getCollection } from 'astro:content';
import TechBadge from './TechBadge.astro';
import { type Lang, defaultLang, useTranslations } from '../i18n/ui';

interface Props {
  lang?: Lang;
}

const { lang = defaultLang } = Astro.props;
const t = useTranslations(lang);

const allProjects = await getCollection('projects');
// Filter projects by current language (matching either frontmatter lang or directory prefix)
const projects = allProjects.filter(p => p.data.lang === lang || p.id.startsWith(`${lang}/`));
// Sort by date descending
projects.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const colorStyles: Record<string, { btn: string; dot: string }> = {
  indigo: {
    btn: "bg-indigo-950/60 hover:bg-indigo-900/80 text-indigo-300 border-indigo-500/40 hover:border-indigo-400 shadow-[0_0_15px_rgba(99,102,241,0.2)]",
    dot: "bg-indigo-400"
  },
  amber: {
    btn: "bg-amber-950/60 hover:bg-amber-900/80 text-amber-300 border-amber-500/40 hover:border-amber-400 shadow-[0_0_15px_rgba(245,158,11,0.2)]",
    dot: "bg-amber-400"
  },
  sky: {
    btn: "bg-sky-950/60 hover:bg-sky-900/80 text-sky-300 border-sky-500/40 hover:border-sky-400 shadow-[0_0_15px_rgba(14,165,233,0.2)]",
    dot: "bg-sky-400"
  },
  rose: {
    btn: "bg-rose-950/60 hover:bg-rose-900/80 text-rose-300 border-rose-500/40 hover:border-rose-400 shadow-[0_0_15px_rgba(244,63,94,0.2)]",
    dot: "bg-rose-400"
  },
  emerald: {
    btn: "bg-emerald-950/60 hover:bg-emerald-900/80 text-emerald-300 border-emerald-500/40 hover:border-emerald-400 shadow-[0_0_15px_rgba(16,185,129,0.2)]",
    dot: "bg-emerald-400"
  },
  zinc: {
    btn: "bg-zinc-900 hover:bg-zinc-800 text-zinc-200 border-zinc-700 hover:border-zinc-500",
    dot: "bg-zinc-400"
  }
};
---
<section class="py-16 md:py-24 border-b border-zinc-800/40 scroll-mt-20" id="projetos">
  <!-- Section Header -->
  <div class="flex flex-col md:flex-row md:items-end justify-between border-b border-zinc-800/40 pb-6 mb-12 gap-4">
    <div>
      <div class="text-xs font-mono uppercase tracking-widest text-zinc-500 mb-2">{t('projects.tag')}</div>
      <h2 class="text-2xl md:text-3xl font-semibold text-zinc-100 tracking-tight">{t('projects.title')}</h2>
    </div>
    <p class="text-sm text-zinc-400 max-w-md font-sans">
      {t('projects.desc')}
    </p>
  </div>

  <!-- Editorial Case Cards -->
  <div class="space-y-8">
    {projects.map((project) => {
      const theme = project.data.brandColor ? colorStyles[project.data.brandColor] || colorStyles.zinc : colorStyles.zinc;
      const slug = project.id.replace(/^(pt|en)\//, '');
      return (
        <article class="border border-zinc-800/60 bg-zinc-900/10 hover:bg-zinc-900/25 hover:border-zinc-700/70 rounded p-6 md:p-8 transition-colors duration-150 flex flex-col group">
          <!-- Card Header -->
          <div class="flex flex-col lg:flex-row lg:items-start justify-between gap-4 mb-4">
            <div class="space-y-2">
              {project.data.toolkit && (
                <div class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded text-[11px] font-mono text-zinc-400 bg-zinc-900 border border-zinc-800">
                  <span class={`w-1.5 h-1.5 rounded-full ${theme.dot}`}></span>
                  <span>{t('projects.toolkit_badge')}</span>
                </div>
              )}
              <a href={`/${lang}/projects/${slug}`} class="block group-hover:text-white transition-colors">
                <h3 class="text-xl md:text-2xl font-semibold text-zinc-100 tracking-tight flex items-center gap-2">
                  <span>{project.data.title}</span>
                  <span class="text-zinc-600 group-hover:text-zinc-400 group-hover:translate-x-0.5 transition-all text-base">&nearr;</span>
                </h3>
              </a>
            </div>
            
            {project.data.tags && project.data.tags.length > 0 && (
              <div class="flex flex-wrap gap-1.5 lg:justify-end">
                {project.data.tags.map((tag) => (
                  <TechBadge tech={tag} />
                ))}
              </div>
            )}
          </div>

          <!-- Description -->
          <p class="text-sm md:text-base text-zinc-300 leading-relaxed max-w-3xl mb-8 font-sans">
            {project.data.description}
          </p>
          
          <!-- 3-Column Architecture Breakdown -->
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6 pt-6 border-t border-zinc-800/40 text-sm">
            <div>
              <div class="text-[11px] font-mono text-amber-500/90 uppercase tracking-wider mb-1.5">
                {t('projects.problem')}
              </div>
              <p class="text-zinc-400 font-sans leading-relaxed text-xs md:text-sm">
                {project.data.problem}
              </p>
            </div>
            <div>
              <div class="text-[11px] font-mono text-zinc-500 uppercase tracking-wider mb-1.5">
                {t('projects.solution')}
              </div>
              <p class="text-zinc-400 font-sans leading-relaxed text-xs md:text-sm">
                {project.data.solution}
              </p>
            </div>
            <div>
              <div class="text-[11px] font-mono text-emerald-400/90 uppercase tracking-wider mb-1.5">
                {t('projects.impact')}
              </div>
              <p class="text-zinc-200 font-sans leading-relaxed text-xs md:text-sm font-medium">
                {project.data.impact}
              </p>
            </div>
          </div>

          <!-- Direct Actions Bar (Live Tool, GitHub, and Case Study) -->
          <div class="flex flex-wrap items-center justify-between gap-4 pt-6 mt-6 border-t border-zinc-800/40 text-xs font-mono">
            <div class="flex flex-wrap items-center gap-3">
              {project.data.liveUrl && (
                <a
                  href={project.data.liveUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class={`inline-flex items-center gap-1.5 px-3 py-1.5 rounded text-xs font-medium border transition-all ${theme.btn}`}
                >
                  <span class={`w-1.5 h-1.5 rounded-full ${theme.dot}`}></span>
                  <span>{t('projects.open_tool')}</span>
                  <span aria-hidden="true">&nearr;</span>
                </a>
              )}
              {project.data.repoUrl && (
                <a
                  href={project.data.repoUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded text-xs text-zinc-400 hover:text-zinc-100 bg-zinc-900/60 hover:bg-zinc-800 border border-zinc-800 hover:border-zinc-700 transition-colors"
                >
                  <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor">
                    <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
                  </svg>
                  <span>{t('projects.github')}</span>
                  <span aria-hidden="true">&nearr;</span>
                </a>
              )}
            </div>

            <a
              href={`/${lang}/projects/${slug}`}
              class="inline-flex items-center gap-1 text-zinc-400 hover:text-white transition-colors group/link"
            >
              <span>{t('projects.view_study')}</span>
              <span class="group-hover/link:translate-x-0.5 transition-transform" aria-hidden="true">&rarr;</span>
            </a>
          </div>
        </article>
      );
    })}
  </div>
</section>
