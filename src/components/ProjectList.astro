---
import { getCollection } from 'astro:content';
import TechBadge from './TechBadge.astro';
import Window from './Window.astro';
import SectionHead from './SectionHead.astro';
import { type Lang, defaultLang, useTranslations } from '../i18n/ui';

interface Props {
  lang?: Lang;
}

const { lang = defaultLang } = Astro.props;
const t = useTranslations(lang);

const allProjects = await getCollection('projects');
// Filter projects by current language
const projects = allProjects.filter(p => p.data.lang === lang || p.id.startsWith(`${lang}/`));

const gcpProject = projects.find(p => p.id.includes('gcp-migration-6tb'));
const imobiProject = projects.find(p => p.id.includes('imobi'));

const retroProject = projects.find(p => p.id.includes('retroyrd'));
const dailyProject = projects.find(p => p.id.includes('dailyyrd'));
const planningProject = projects.find(p => p.id.includes('planningyrd'));
const coffeeProject = projects.find(p => p.id.includes('coffeeyrd'));

// Projetos menores: cartões compactos que levam ao estudo completo
const moreSlugs = ['winshare', 'kanbn-mcp-server', 'gift'];
const moreProjects = moreSlugs
  .map((slug) => projects.find((p) => p.id.endsWith(`/${slug}`) || p.id === slug || p.id.includes(`/${slug}.`)))
  .filter((p): p is NonNullable<typeof p> => Boolean(p));

const dotColors: Record<string, string> = {
  indigo: 'bg-indigo-400',
  amber: 'bg-amber-400',
  sky: 'bg-sky-400',
  rose: 'bg-rose-400',
  emerald: 'bg-emerald-400',
  zinc: 'bg-zinc-400',
};

const cases = [
  gcpProject && {
    project: gcpProject,
    slug: 'gcp-migration-6tb',
    badge: t('projects.case_enterprise_badge'),
    note: lang === 'pt' ? 'Infraestrutura como Código · Terraform · Windows Server 2022' : 'Infrastructure as Code · Terraform · Windows Server 2022',
  },
  imobiProject && {
    project: imobiProject,
    slug: 'imobi',
    badge: t('projects.case_production_badge'),
    note: '',
  },
].filter(Boolean) as { project: NonNullable<typeof gcpProject>; slug: string; badge: string; note: string }[];

const arrowLink = 'text-term-dim hover:text-term-green transition-colors';

const suiteTools = [
  {
    name: 'RetroYrd',
    slug: 'retroyrd',
    role: lang === 'pt' ? 'Retrospectivas Ágeis & IA (MCP)' : 'Agile Retrospectives & AI (MCP)',
    desc: lang === 'pt' 
      ? 'Máquina de estados finitos (FSM) de 6 fases, anonimato real e servidor nativo MCP para agentes de IA estruturarem planos de ação em tempo real.'
      : 'Deterministic 6-phase FSM, real anonymity, and native MCP server for AI agents to synthesize action items in real time.',
    color: 'indigo',
    liveUrl: 'https://retro.yared.com.br',
    repoUrl: 'https://github.com/Yared98/retroyrd',
  },
  {
    name: 'DailyYrd',
    slug: 'dailyyrd',
    role: lang === 'pt' ? 'Dailies Síncronas & Assíncronas' : 'Synchronous & Async Dailies',
    desc: lang === 'pt'
      ? 'Dailies de alta velocidade com cronômetro sincronizado via WebSockets, orquestração de turnos de fala e exportação atômica de impedimentos.'
      : 'High-speed standups with distributed WebSocket timers, speaking queue orchestration, and atomic blocker exports.',
    color: 'amber',
    liveUrl: 'https://daily.yared.com.br',
    repoUrl: 'https://github.com/Yared98/dailyyrd',
  },
  {
    name: 'PlanningYrd',
    slug: 'planningyrd',
    role: lang === 'pt' ? 'Planning Poker & Estimativas' : 'Planning Poker & Estimation',
    desc: lang === 'pt'
      ? 'Votação simultânea e cega com cálculo automático de dispersão estatística e consenso da equipe sem viés de ancoragem.'
      : 'Simultaneous blind voting with automated statistical consensus and complexity variance calculation without anchoring bias.',
    color: 'sky',
    liveUrl: 'https://planning.yared.com.br',
    repoUrl: 'https://github.com/Yared98/planningyrd',
  },
  {
    name: 'CoffeeYrd',
    slug: 'coffeeyrd',
    role: lang === 'pt' ? 'Pausas Sincronizadas & Foco' : 'Synchronized Breaks & Focus',
    desc: lang === 'pt'
      ? 'Quick break coletivo com sincronização em tempo real e retorno coordenado para manter a energia e foco das equipes técnicas.'
      : 'Collective quick-break room with real-time synchronized timers to coordinate team cadence and preserve focus.',
    color: 'rose',
    liveUrl: 'https://coffee.yared.com.br',
    repoUrl: 'https://github.com/Yared98/coffeeyrd',
  },
];
---

<!-- ===== GRUPO A: CLIENTES ===== -->
<section class="pt-16 md:pt-24 pb-12 scroll-mt-20" id="projetos">
  <SectionHead
    label={lang === 'pt' ? 'CLIENTES' : 'CLIENTS'}
    title={lang === 'pt' ? 'Entregue para clientes' : 'Delivered for clients'}
    desc={lang === 'pt' ? 'Sistemas e migrações em produção, feitos sob encomenda.' : 'Production systems and migrations, built to order.'}
  />

  <div class="space-y-8">
    {cases.map(({ project, slug, badge, note }) => (
      <Window as="article" title={`cases/${slug}`} meta={badge}>
        <div class="flex flex-col lg:flex-row lg:items-start justify-between gap-4 mb-4">
          <h3 class="text-xl md:text-2xl font-semibold text-zinc-100 break-words min-w-0">
            <a href={`/${lang}/projects/${slug}/`} class="hover:text-term-green transition-colors">{project.data.title}</a>
          </h3>
          {project.data.tags && (
            <div class="flex flex-wrap gap-1.5 lg:justify-end">
              {project.data.tags.map((tag) => (
                <TechBadge tech={tag} />
              ))}
            </div>
          )}
        </div>

        <p class="text-sm md:text-base text-zinc-300 leading-relaxed max-w-3xl mb-6">
          {project.data.description}
        </p>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 pt-6 border-t border-term-line text-sm">
          <div>
            <div class="text-[11px] font-mono text-term-orange uppercase tracking-wider mb-1.5">{t('projects.problem')}</div>
            <p class="text-zinc-400 leading-relaxed text-xs md:text-sm">{project.data.problem}</p>
          </div>
          <div>
            <div class="text-[11px] font-mono text-term-blue uppercase tracking-wider mb-1.5">{t('projects.solution')}</div>
            <p class="text-zinc-400 leading-relaxed text-xs md:text-sm">{project.data.solution}</p>
          </div>
          <div>
            <div class="text-[11px] font-mono text-term-green uppercase tracking-wider mb-1.5">{t('projects.impact')}</div>
            <p class="text-zinc-200 leading-relaxed text-xs md:text-sm font-medium">{project.data.impact}</p>
          </div>
        </div>

        <Fragment slot="status">
          <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-3 font-mono text-xs w-full">
            <div class="flex flex-wrap items-center gap-x-4 gap-y-2 min-w-0">
              {note && <span class="text-term-dim">{note}</span>}
              {project.data.liveUrl && (
                <a href={project.data.liveUrl} target="_blank" rel="noopener noreferrer" class={arrowLink}>
                  {t('projects.open_tool_online')} <span aria-hidden="true">&nearr;</span>
                </a>
              )}
            </div>
            <a href={`/${lang}/projects/${slug}/`} class="btn-tui">
              {t('projects.view_study')} <span aria-hidden="true">&rarr;</span>
            </a>
          </div>
        </Fragment>
      </Window>
    ))}
  </div>
</section>

<!-- ===== GRUPO B: LAB ===== -->
<section class="py-12 md:py-16 border-t border-term-line scroll-mt-20" id="lab">
  <SectionHead
    label="LAB"
    title={lang === 'pt' ? 'Produtos próprios e projetos pessoais' : 'Own products and personal projects'}
    desc={lang === 'pt' ? 'Ferramentas que construí por conta própria, abertas e em uso.' : 'Tools I built on my own, open source and in use.'}
  />

  <div class="space-y-8">
    <!-- Yrd Agile Toolkit -->
    <Window as="article" title="lab/yrd-agile-toolkit" meta={t('projects.toolkit_suite_badge')}>
      <div class="flex flex-col lg:flex-row lg:items-start justify-between gap-4 mb-4">
        <h3 class="text-xl md:text-2xl font-semibold text-zinc-100 break-words min-w-0">
          Yrd Agile Toolkit — {lang === 'pt' ? 'Suite de Microsserviços Colaborativos em Tempo Real' : 'Real-Time Collaborative Microservices Suite'}
        </h3>
        <div class="flex flex-wrap gap-1.5 lg:justify-end">
          <TechBadge tech="Rust" />
          <TechBadge tech="Axum" />
          <TechBadge tech="WebSockets" />
          <TechBadge tech="SQLite" />
          <TechBadge tech="MCP (Model Context Protocol)" />
          <TechBadge tech="React" />
          <TechBadge tech="Docker" />
        </div>
      </div>

      <p class="text-sm md:text-base text-zinc-300 leading-relaxed max-w-4xl mb-6">
        {lang === 'pt'
          ? 'Arquitetura distribuída autohospedada de ferramentas colaborativas em tempo real. Cada microsserviço é um binário autônomo nativo em Rust (Axum + Tokio WebSockets) com banco embarcado SQLite em modo WAL, comunicação bidirecional de sub-milissegundo, integração com IA via Model Context Protocol (MCP) e pegada inferior a 20MB de RAM por serviço.'
          : 'Sovereign distributed real-time collaborative platform. Each microservice is an autonomous native Rust binary (Axum + Tokio WebSockets) with embedded SQLite WAL storage, sub-millisecond bidirectional WebSockets, native AI orchestration via Model Context Protocol (MCP), and a memory footprint under 20MB RAM per instance.'}
      </p>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 pt-6 border-t border-term-line text-sm mb-8">
        <div>
          <div class="text-[11px] font-mono text-term-orange uppercase tracking-wider mb-1.5">{t('projects.problem')}</div>
          <p class="text-zinc-400 leading-relaxed text-xs md:text-sm">
            {lang === 'pt'
              ? 'Dependência de múltiplos SaaS proprietários com cobrança mensal por usuário, consumo pesado de memória no navegador e histórico sensível de discussões armazenado em servidores externos.'
              : 'Reliance on expensive per-seat SaaS meeting platforms, browser bloat, and proprietary clouds holding confidential team discussions and strategic planning data.'}
          </p>
        </div>
        <div>
          <div class="text-[11px] font-mono text-term-blue uppercase tracking-wider mb-1.5">{t('projects.solution')}</div>
          <p class="text-zinc-400 leading-relaxed text-xs md:text-sm">
            {lang === 'pt'
              ? 'Suite integrada de 4 microsserviços autônomos em Rust, com sincronização em tempo real via WebSockets, FSM determinística, persistência atômica e conectores MCP para agentes de IA.'
              : 'Unified suite of 4 autonomous Rust microservices featuring real-time WebSocket state synchronization, deterministic state machines, atomic persistence, and MCP connectors for AI agents.'}
          </p>
        </div>
        <div>
          <div class="text-[11px] font-mono text-term-green uppercase tracking-wider mb-1.5">{t('projects.impact')}</div>
          <p class="text-zinc-200 leading-relaxed text-xs md:text-sm font-medium">
            {lang === 'pt'
              ? '100% de soberania sobre os dados, zero custo de licença recorrente, footprint inferior a 20MB de RAM por nó e síntese automatizada de planos de ação via IA.'
              : '100% data sovereignty, zero recurring SaaS seat licensing, sub-20MB RAM memory footprint per node, and automated AI action item synthesis.'}
          </p>
        </div>
      </div>

      <div class="border-t border-term-line pt-6">
        <div class="flex flex-wrap items-center justify-between gap-2 mb-4 font-mono text-xs">
          <h4 class="uppercase tracking-wider text-zinc-400">{t('projects.toolkit_subtools_title')}</h4>
          <span class="text-term-dim">{lang === 'pt' ? '4 nós operacionais independentes' : '4 independent operational nodes'}</span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {suiteTools.map((tool) => (
            <div class="border border-term-line bg-black/20 p-4 flex flex-col justify-between min-w-0">
              <div>
                <div class="flex flex-wrap items-center justify-between gap-2 mb-2">
                  <div class="flex items-center gap-2">
                    <span class={`w-2 h-2 rounded-full ${dotColors[tool.color] ?? dotColors.zinc}`} aria-hidden="true"></span>
                    <h5 class="text-base font-semibold text-zinc-100">{tool.name}</h5>
                  </div>
                  <span class="chip">{tool.role}</span>
                </div>
                <p class="text-xs text-zinc-400 leading-relaxed mb-4">{tool.desc}</p>
              </div>

              <div class="flex flex-wrap items-center gap-x-4 gap-y-2 pt-3 border-t border-term-line text-xs font-mono">
                <a href={tool.liveUrl} target="_blank" rel="noopener noreferrer" class="text-term-green hover:underline">
                  {t('projects.open_tool')} <span aria-hidden="true">&nearr;</span>
                </a>
                <a href={tool.repoUrl} target="_blank" rel="noopener noreferrer" class={arrowLink}>
                  GitHub <span aria-hidden="true">&nearr;</span>
                </a>
                <a href={`/${lang}/projects/${tool.slug}/`} class={arrowLink}>
                  {t('projects.read_article')} <span aria-hidden="true">&rarr;</span>
                </a>
              </div>
            </div>
          ))}
        </div>
      </div>
    </Window>

    <!-- Mais projetos -->
    {moreProjects.length > 0 && (
      <div>
        <div class="mb-4 font-mono">
          <h3 class="text-base md:text-lg font-semibold text-zinc-100">{t('projects.more_title')}</h3>
          <p class="text-sm text-term-dim mt-1">{t('projects.more_desc')}</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          {moreProjects.map((p) => {
            const slug = p.id.split('/').pop()!.replace(/\.mdx?$/, '');
            const year = p.data.date ? String(p.data.date.getFullYear()) : undefined;
            return (
              <Window as="article" title={`lab/${slug}`} meta={year} class="min-w-0">
                <h4 class="text-base font-semibold text-zinc-100 flex items-center gap-2">
                  <span class={`w-1.5 h-1.5 rounded-full ${dotColors[p.data.brandColor ?? 'zinc'] ?? dotColors.zinc}`} aria-hidden="true"></span>
                  <span class="break-words min-w-0">{slug}</span>
                </h4>
                <p class="text-sm text-zinc-300 leading-relaxed mt-3">{p.data.description}</p>
                {p.data.tags && (
                  <div class="flex flex-wrap gap-1.5 mt-4">
                    {p.data.tags.slice(0, 4).map((tag) => <TechBadge tech={tag} />)}
                  </div>
                )}
                <Fragment slot="status">
                  <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-2 font-mono text-xs w-full">
                    {p.data.repoUrl ? (
                      <a href={p.data.repoUrl} target="_blank" rel="noopener noreferrer" class={arrowLink}>{t('projects.view_repo')} <span aria-hidden="true">&nearr;</span></a>
                    ) : <span></span>}
                    <a href={`/${lang}/projects/${slug}/`} class="text-term-green hover:underline">
                      {t('projects.view_study')} <span aria-hidden="true">&rarr;</span>
                    </a>
                  </div>
                </Fragment>
              </Window>
            );
          })}
        </div>
      </div>
    )}
  </div>
</section>
