---
// "Como funciona": as quatro etapas de um projeto, como um pipeline numerado.
import SectionHead from './SectionHead.astro';
import { process } from '../data/services';
import { type Lang, defaultLang } from '../i18n/ui';

interface Props {
  lang?: Lang;
}

const { lang = defaultLang } = Astro.props;
const steps = process[lang] || process.pt;
const c = {
  pt: { label: 'PROCESSO', title: 'Como um projeto anda', desc: 'Da primeira conversa ao sistema em produção, sem surpresa no meio do caminho.' },
  en: { label: 'PROCESS', title: 'How a project runs', desc: 'From the first conversation to the system in production, with no surprises along the way.' },
}[lang];
---

<section class="border-t border-term-line/60 py-16 md:py-20 scroll-mt-20" id="processo">
  <SectionHead label={c.label} title={c.title} desc={c.desc} />

  <ol class="grid grid-cols-1 gap-x-6 gap-y-8 sm:grid-cols-2 lg:grid-cols-4">
    {steps.map((s, i) => (
      <li class="step">
        <div class="flex items-center gap-2 font-mono text-xs text-term-dim" aria-hidden="true">
          <span class="text-term-green">[{String(i + 1).padStart(2, '0')}]</span>
          <span class="step-rule"></span>
          <span>{i < steps.length - 1 ? '▸' : '■'}</span>
        </div>
        <h3 class="mt-3 font-mono text-base font-semibold text-zinc-50">{s.title}</h3>
        <p class="mt-2 text-sm leading-relaxed text-zinc-400">{s.desc}</p>
      </li>
    ))}
  </ol>
</section>

<style>
  .step-rule {
    flex: 1;
    border-top: 1px dashed var(--color-term-line);
  }
</style>
