---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ProjectList from '../../components/ProjectList.astro';
---

<Layout 
  title="Projetos & Casos de Engenharia | Matheus Yared"
  description="Registro de projetos de software, migrações de dados em escala de terabytes e arquiteturas em produção."
>
  <Breadcrumbs segments={[{ label: 'Projetos', href: '/projects' }]} />
  
  <section class="mt-4 mb-16">
    <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-full text-xs font-mono bg-zinc-900 border border-zinc-800 text-zinc-400 mb-6">
      <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
      CASOS SELECIONADOS &middot; PRODUÇÃO REAL
    </div>
    <h1 class="text-3xl md:text-5xl font-sans font-semibold tracking-tight text-zinc-100 mb-6 leading-tight">
      Projetos &amp; Engenharia de Sistemas.
    </h1>
    <p class="text-zinc-300 font-serif max-w-3xl leading-relaxed text-lg">
      Um registro técnico das arquiteturas e produtos em que atuei diretamente. Casos reais onde a análise pragmática e a execução de baixo nível resolveram desafios de escala, latência e integridade operacional.
    </p>
  </section>

  <ProjectList />
</Layout>
