---
import Layout from '../layouts/Layout.astro';
import AsciiPiece from '../components/AsciiPiece.astro';
---

<Layout
  title="404 — Página não encontrada | MY."
  description="Esta página não existe ou foi movida."
  noindex
>
  <div class="grid md:grid-cols-2 gap-10 items-center min-h-[50vh] py-16">
    <div class="flex flex-col items-start justify-center">
    <p class="font-mono text-sm text-term-red mb-2">cd: no such file or directory</p>
    <div class="prompt mb-6">cd {'/'}404</div>
    <h1 class="text-4xl md:text-6xl font-semibold text-zinc-100 mb-6">
      Página não <span class="text-term-dim">encontrada.</span>
    </h1>
    <p class="text-zinc-400 max-w-md mb-10 leading-relaxed">
      A rota que você tentou acessar não existe ou foi movida. Confira o endereço ou volte para a home.
    </p>
    <a href="/" id="not-found-home-link" class="btn-tui">
      <span aria-hidden="true">&larr;</span> Voltar para home
    </a>
    </div>
    <AsciiPiece
      piece="peekaboo-box"
      label="Uma caixa de papelão vazia balança e dois olhos espiam de dentro: a página não está aqui"
      panel={false}
      minPx={10}
      maxPx={16}
      class="my-0"
    />
  </div>
</Layout>
