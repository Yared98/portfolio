---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Recommendations from '../../components/Recommendations.astro';
import TechBadge from '../../components/TechBadge.astro';
import TechTicker from '../../components/TechTicker.astro';
import Window from '../../components/Window.astro';
import SectionHead from '../../components/SectionHead.astro';
import Principles from '../../components/Principles.astro';
import HomelabCallout from '../../components/HomelabCallout.astro';
import { type Lang, useTranslations } from '../../i18n/ui';

export function getStaticPaths() {
  return [
    { params: { lang: 'pt' } },
    { params: { lang: 'en' } },
  ];
}

const { lang } = Astro.params as { lang: Lang };
const t = useTranslations(lang);

const experienceData = {
  pt: [
    {
      role: "Engenheiro de Software Especialista",
      company: "Grupo Boticário",
      date: "Julho 2025 — Presente",
      highlights: [
        "Evolução do ecossistema de retaguarda das lojas conectado ao ecossistema digital.",
        "Garantia da integridade e do desempenho do fluxo de dados entre varejo físico e plataformas digitais visando alta disponibilidade.",
        "Desenvolvimento de serviços fundamentais em Node.js e ferramentas de automação em Python.",
        "Redução de fricção operacional e suporte direto à capacidade de escala da operação do grupo."
      ]
    },
    {
      role: "Analista Técnico de Soluções & Negócios",
      company: "Grupo Boticário",
      date: "Agosto 2020 — Agosto 2025",
      highlights: [
        "Sustentação de arquitetura de alta disponibilidade: Gestão de crises, incidentes críticos e automação de processos de varejo.",
        "Resolução de problemas sistêmicos e incidentes em fluxos comerciais, financeiros, fiscais e de estoque.",
        "Uso avançado de T-SQL para inteligência de dados, ajustes cirúrgicos e análise de banco de dados em larga escala.",
        "Práticas de desenvolvimento e operações: Monitoramento contínuo de implantações (deployments) em homologação e produção, além de scripts para automatizar demandas diárias."
      ]
    }
  ],
  en: [
    {
      role: "Specialist Software Engineer",
      company: "Grupo Boticário",
      date: "July 2025 — Present",
      highlights: [
        "Evolution of retail store backend ecosystem integrated with omnichannel digital platforms.",
        "Ensuring end-to-end data integrity and high-throughput transactional performance between physical retail and digital services.",
        "Core backend microservices development in Node.js and operational automation tooling in Python.",
        "Eliminating operational friction and engineering foundation for high-volume enterprise scale."
      ]
    },
    {
      role: "Technical Solutions & Business Analyst",
      company: "Grupo Boticário",
      date: "August 2020 — August 2025",
      highlights: [
        "High-availability architecture resilience: critical incident management, crisis mitigation, and retail process automation.",
        "Resolution of systemic anomalies across commercial, financial, fiscal, and inventory workflows.",
        "Advanced T-SQL query performance tuning, execution plan analysis, and large-scale enterprise database optimization.",
        "DevOps & continuous monitoring of production rollouts, automated health-checks, and tactical operational scripts."
      ]
    }
  ]
};

const educationData = {
  pt: [
    {
      degree: "Análise e Desenvolvimento de Sistemas",
      institution: "Unicesumar",
      date: "Graduação Superior"
    },
    {
      degree: "Certificações & Especializações",
      institution: "Segurança de Software (Security Champions), LGPD (Privacidade de Dados), Pensamento Estratégico, Framework Scrum",
      date: "Qualificações Contínuas"
    }
  ],
  en: [
    {
      degree: "Systems Analysis and Software Development",
      institution: "Unicesumar",
      date: "Higher Education Degree"
    },
    {
      degree: "Certifications & Specializations",
      institution: "Software Security (Security Champions), LGPD / Data Privacy, Strategic Thinking, Scrum Framework",
      date: "Continuous Education"
    }
  ]
};

const skillsData = {
  pt: [
    { category: "Back-end & Arquitetura", items: ["Node.js", "Python", "Rust", "PHP / Laravel", "C"] },
    { category: "Dados & Desempenho", items: ["T-SQL", "SQL Server", "PostgreSQL", "Otimização de Índices", "ZFS"] },
    { category: "Operação & Segurança", items: ["Docker / LXC", "Cloudflare Zero-Trust", "LGPD / Governança", "Observabilidade"] }
  ],
  en: [
    { category: "Backend & Architecture", items: ["Node.js", "Python", "Rust", "PHP / Laravel", "C"] },
    { category: "Data & Performance", items: ["T-SQL", "SQL Server", "PostgreSQL", "Index Optimization", "ZFS"] },
    { category: "Operations & Security", items: ["Docker / LXC", "Cloudflare Zero-Trust", "Data Governance / LGPD", "Observability"] }
  ]
};

const experience = experienceData[lang] || experienceData.pt;
const education = educationData[lang] || educationData.pt;
const skills = skillsData[lang] || skillsData.pt;
const tickerItems = [...new Set(skills.flatMap((s) => s.items))];
---

<Layout 
  title={`${t('career.title')} | Matheus Yared`}
  description={t('career.lead')}
  lang={lang}
>
  <Breadcrumbs 
    segments={[{ label: t('crumbs.trajectory'), href: `/${lang}/trajetoria/` }]} 
    lang={lang}
  />
  
  <section class="mt-4 mb-10">
    <SectionHead level={1} label={lang === 'pt' ? 'SOBRE' : 'ABOUT'} title={t('career.title')} desc={t('career.lead')} class="!mb-4" />
    <p class="text-zinc-400 max-w-3xl leading-relaxed text-sm">
      <strong class="text-term-green font-mono text-xs uppercase tracking-wider">{t('career.consultative_title')}</strong> {t('career.consultative_desc')}
    </p>
  </section>

  <TechTicker items={tickerItems} />

  <div class="space-y-16">
    <!-- Experience -->
    <section>
      <h2 class="prompt mb-6">{t('career.experience_title')}</h2>
      <div class="space-y-4">
        {experience.map((job) => (
          <Window as="article" title={job.company} meta={job.date}>
            <h3 class="text-lg md:text-xl font-semibold text-zinc-100 mb-4">{job.role}</h3>
            <ul class="text-sm text-zinc-300 space-y-2.5 leading-relaxed">
              {job.highlights.map((item) => (
                <li class="flex gap-2"><span class="text-term-green font-mono shrink-0" aria-hidden="true">&gt;</span><span class="min-w-0">{item}</span></li>
              ))}
            </ul>
          </Window>
        ))}
      </div>
    </section>

    <!-- Skills and Competencies -->
    <section>
      <h2 class="prompt mb-6">{t('career.skills_title')}</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        {skills.map((s) => (
          <Window as="article" title={s.category}>
            <h3 class="sr-only">{s.category}</h3>
            <div class="flex flex-wrap gap-x-3 gap-y-2">
              {s.items.map((item: string) => (
                <TechBadge tech={item} />
              ))}
            </div>
          </Window>
        ))}
      </div>
    </section>

    <!-- Education -->
    <section>
      <h2 class="prompt mb-6">{t('career.education_title')}</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {education.map((edu) => (
          <Window as="article" title={edu.date}>
            <h3 class="text-lg font-semibold text-zinc-100 mb-2">{edu.degree}</h3>
            <p class="text-sm text-zinc-400 leading-relaxed">{edu.institution}</p>
          </Window>
        ))}
      </div>
    </section>
  </div>

  <Principles lang={lang} />
  <HomelabCallout lang={lang} />

  <Recommendations lang={lang} />

  <section class="py-16">
    <Window title={lang === 'pt' ? 'contato' : 'contact'}>
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <p class="text-zinc-300">{lang === 'pt' ? 'Quer conversar sobre um projeto?' : 'Want to talk about a project?'}</p>
        <a href={`/${lang}/#contato`} class="btn-tui self-start">
          <span>{lang === 'pt' ? 'Solicitar orçamento' : 'Request a quote'}</span>
          <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </Window>
  </section>
</Layout>
