---
import { render } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import Window from '../../../components/Window.astro';
import { type Lang, useTranslations } from '../../../i18n/ui';
import { type Article, getArticles, articleSlug, formatDate } from '../../../utils/articles';

export async function getStaticPaths() {
  const langs: Lang[] = ['pt', 'en'];
  const paths = [];
  for (const lang of langs) {
    for (const article of await getArticles(lang)) {
      paths.push({ params: { lang, id: articleSlug(article) }, props: { article, lang } });
    }
  }
  return paths;
}

const { article, lang } = Astro.props as { article: Article; lang: Lang };
const { Content } = await render(article);
const t = useTranslations(lang);
---

<Layout title={`${article.data.title} | Matheus Yared`} description={article.data.description} lang={lang}>
  <Breadcrumbs
    segments={[
      { label: t('crumbs.articles'), href: `/${lang}/artigos/` },
      { label: articleSlug(article) },
    ]}
    lang={lang}
  />

  <article class="mx-auto mt-4 max-w-3xl pb-8">
    <header class="mb-10 border-b border-term-line pb-8">
      <p class="font-mono text-xs text-term-dim">
        <time datetime={article.data.date.toISOString()}>{formatDate(article.data.date, lang)}</time>
        {article.data.draft && <span class="ml-3 text-term-orange">[{lang === 'pt' ? 'rascunho' : 'draft'}]</span>}
      </p>
      <h1 class="mt-4 text-3xl font-semibold leading-[1.15] text-zinc-50 md:text-4xl">{article.data.title}</h1>
      <p class="mt-4 text-lg leading-relaxed text-zinc-400">{article.data.description}</p>
      {article.data.tags && (
        <div class="mt-5 flex flex-wrap gap-x-2 gap-y-1">
          {article.data.tags.map((tag) => <span class="chip">{tag}</span>)}
        </div>
      )}
    </header>

    <div class="mdx-content text-base leading-relaxed text-zinc-300">
      <Content />
    </div>

    <Window title={lang === 'pt' ? 'contato' : 'contact'} class="mt-14">
      <p class="text-base text-zinc-200">
        {lang === 'pt' ? 'Tem um problema parecido na sua empresa?' : 'Have a similar problem at your company?'}
      </p>
      <div class="mt-4 flex flex-wrap gap-3">
        <a href={`/${lang}/#contato`} class="btn-tui">{t('nav.quote')} <span aria-hidden="true">↵</span></a>
        <a href={`/${lang}/artigos/`} class="btn-ghost">{lang === 'pt' ? 'Todos os artigos' : 'All articles'}</a>
      </div>
    </Window>
  </article>
</Layout>
