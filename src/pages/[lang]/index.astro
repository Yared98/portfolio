---
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/Hero.astro';
import ServiceGrid from '../../components/ServiceGrid.astro';
import Process from '../../components/Process.astro';
import ProjectList from '../../components/ProjectList.astro';
import Recommendations from '../../components/Recommendations.astro';
import Contact from '../../components/Contact.astro';
import { type Lang } from '../../i18n/ui';

export function getStaticPaths() {
  return [
    { params: { lang: 'pt' } },
    { params: { lang: 'en' } },
  ];
}

const { lang } = Astro.params as { lang: Lang };

const titles = {
  pt: "Software sob medida, integrações e infraestrutura | Matheus Yared",
  en: "Custom software, integrations and infrastructure | Matheus Yared",
};

const descriptions = {
  pt: "Desenvolvo sistemas, integrações com IA, migrações para a nuvem e diagnósticos de performance sob encomenda para empresas. Escopo claro, entrega em produção e código que fica com você.",
  en: "I build systems, AI integrations, cloud migrations and performance diagnostics to order for companies. Clear scope, delivery in production, and code that stays with you.",
};
---

<Layout
  title={titles[lang] || titles.pt}
  description={descriptions[lang] || descriptions.pt}
  lang={lang}
>
  <Hero lang={lang} />
  <ServiceGrid lang={lang} />
  <Process lang={lang} />
  <ProjectList lang={lang} />
  <Recommendations lang={lang} />
  <Contact lang={lang} />
</Layout>
