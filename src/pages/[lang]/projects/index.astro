---
import Layout from '../../../layouts/Layout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import ProjectList from '../../../components/ProjectList.astro';
import SectionHead from '../../../components/SectionHead.astro';
import { type Lang, useTranslations } from '../../../i18n/ui';

export function getStaticPaths() {
  return [
    { params: { lang: 'pt' } },
    { params: { lang: 'en' } },
  ];
}

const { lang } = Astro.params as { lang: Lang };
const t = useTranslations(lang);

const titles = {
  pt: "Projetos & Casos de Engenharia | Matheus Yared",
  en: "Projects & Engineering Case Studies | Matheus Yared",
};

const descriptions = {
  pt: "Registro de projetos de software, migrações de dados em escala de terabytes e arquiteturas em produção.",
  en: "Technical portfolio of software projects, terabyte-scale data migrations, and production systems.",
};
---

<Layout 
  title={titles[lang] || titles.pt}
  description={descriptions[lang] || descriptions.pt}
  lang={lang}
>
  <Breadcrumbs 
    segments={[{ label: t('crumbs.projects'), href: `/${lang}/projects` }]} 
    lang={lang}
  />
  
  <section class="mt-4">
    <SectionHead level={1} label={lang === 'pt' ? 'PROJETOS' : 'PROJECTS'} title={t('projects.all_cases_title')} desc={t('projects.all_cases_desc')} />
  </section>

  <ProjectList lang={lang} />
</Layout>
