---
import { getCollection, render } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import TechBadge from '../../../components/TechBadge.astro';
import Window from '../../../components/Window.astro';
import { type Lang, useTranslations } from '../../../i18n/ui';

export async function getStaticPaths() {
  const allProjects = await getCollection('projects');
  return allProjects.map((project) => {
    const parts = project.id.split('/');
    const lang = parts.length > 1 ? parts[0] : (project.data.lang || 'pt');
    const slug = parts.length > 1 ? parts[1] : project.id;
    return {
      params: { lang, id: slug },
      props: { project, lang },
    };
  });
}

const { project, lang } = Astro.props as { project: any; lang: Lang };
const { Content } = await render(project);
const t = useTranslations(lang);
---

<Layout 
  title={`${project.data.title} | Matheus Yared`}
  description={project.data.description}
  lang={lang}
>
  <Breadcrumbs 
    segments={[
      { label: t('crumbs.projects'), href: `/${lang}/projects` },
      { label: project.data.title }
    ]} 
    lang={lang}
  />
  
  <article class="mt-4 pb-16">
    <header class="mb-10 border-b border-term-line pb-8">
      <div class="max-w-4xl">
        <div class="flex flex-wrap items-center gap-3 text-xs text-term-dim font-mono mb-4">
          <span class="text-term-green" aria-hidden="true">$</span>
          <time datetime={project.data.date.toISOString()}>
            {project.data.date.toLocaleDateString(lang === 'pt' ? 'pt-BR' : 'en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
          </time>
          {project.data.toolkit && (
            <>
              <span aria-hidden="true">&middot;</span>
              <span class="chip">{t('projects.toolkit_badge')}</span>
            </>
          )}
          {project.data.tags && project.data.tags.length > 0 && (
            <div class="flex flex-wrap gap-1.5 items-center">
              {project.data.tags.map((tag: string) => (
                <TechBadge tech={tag} />
              ))}
            </div>
          )}
        </div>
        
        <h1 class="text-3xl md:text-5xl font-semibold tracking-tight text-zinc-50 leading-tight break-words">
          {project.data.title}
        </h1>

        <p class="mt-6 text-base md:text-lg text-zinc-400 leading-relaxed">
          {project.data.description}
        </p>

        <!-- Tool and Repository Direct Action Buttons -->
        {(project.data.liveUrl || project.data.repoUrl) && (
          <div class="flex flex-wrap items-center gap-3.5 mt-8 pt-6 border-t border-term-line">
            {project.data.liveUrl && (
              <a
                href={project.data.liveUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="btn-tui"
              >
                <span>{t('projects.open_tool_online')}</span>
                <span aria-hidden="true">&nearr;</span>
              </a>
            )}
            
            {project.data.repoUrl && (
              <a 
                href={project.data.repoUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="btn-ghost"
              >
                <svg class="w-3.5 h-3.5" aria-hidden="true" viewBox="0 0 24 24" fill="currentColor">
                  <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
                </svg>
                <span>{t('projects.code_github')}</span>
                <span aria-hidden="true">&nearr;</span>
              </a>
            )}
          </div>
        )}
      </div>
    </header>

    <Window title="summary" class="mb-12">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-8">
        <div>
          <h2 class="text-xs font-mono text-term-orange mb-2.5 uppercase tracking-wider">{t('projects.problem')}</h2>
          <p class="text-sm text-zinc-300 leading-relaxed">{project.data.problem}</p>
        </div>
        <div>
          <h2 class="text-xs font-mono text-term-blue mb-2.5 uppercase tracking-wider">{t('projects.solution')}</h2>
          <p class="text-sm text-zinc-300 leading-relaxed">{project.data.solution}</p>
        </div>
        <div>
          <h2 class="text-xs font-mono text-term-green mb-2.5 uppercase tracking-wider">{t('projects.impact')}</h2>
          <p class="text-sm text-zinc-300 leading-relaxed">{project.data.impact}</p>
        </div>
      </div>
    </Window>

    <div class="mt-8 text-zinc-300 font-sans leading-relaxed mdx-content max-w-3xl">
      <Content />
    </div>

    <Window title="contato" class="mt-16 max-w-3xl">
      <p class="text-base text-zinc-200">
        {lang === 'pt' ? 'Precisa de algo parecido na sua empresa?' : 'Need something like this for your business?'}
      </p>
      <div class="flex flex-wrap items-center gap-3 mt-5">
        <a href={`/${lang}/#contato`} class="btn-tui">
          {lang === 'pt' ? 'Solicitar orçamento' : 'Request a quote'}
        </a>
        <a href={`/${lang}/projects/`} class="btn-ghost">
          {lang === 'pt' ? 'Ver todos os projetos' : 'All projects'}
        </a>
      </div>
    </Window>
  </article>
</Layout>
