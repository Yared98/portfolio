---
import { getCollection, render } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import TechBadge from '../../../components/TechBadge.astro';
import { type Lang, useTranslations } from '../../../i18n/ui';

export async function getStaticPaths() {
  const allProjects = await getCollection('projects');
  return allProjects.map((project) => {
    const parts = project.id.split('/');
    const lang = parts.length > 1 ? parts[0] : (project.data.lang || 'pt');
    const slug = parts.length > 1 ? parts[1] : project.id;
    return {
      params: { lang, id: slug },
      props: { project, lang },
    };
  });
}

const { project, lang } = Astro.props as { project: any; lang: Lang };
const { Content } = await render(project);
const t = useTranslations(lang);

const colorStyles: Record<string, { btn: string; border: string; dot: string }> = {
  indigo: {
    btn: "bg-indigo-950/70 hover:bg-indigo-900/80 text-indigo-200 border-indigo-500/50 hover:border-indigo-400 shadow-[0_0_20px_rgba(99,102,241,0.25)]",
    border: "border-indigo-500/30",
    dot: "bg-indigo-400"
  },
  amber: {
    btn: "bg-amber-950/70 hover:bg-amber-900/80 text-amber-200 border-amber-500/50 hover:border-amber-400 shadow-[0_0_20px_rgba(245,158,11,0.25)]",
    border: "border-amber-500/30",
    dot: "bg-amber-400"
  },
  sky: {
    btn: "bg-sky-950/70 hover:bg-sky-900/80 text-sky-200 border-sky-500/50 hover:border-sky-400 shadow-[0_0_20px_rgba(14,165,233,0.25)]",
    border: "border-sky-500/30",
    dot: "bg-sky-400"
  },
  rose: {
    btn: "bg-rose-950/70 hover:bg-rose-900/80 text-rose-200 border-rose-500/50 hover:border-rose-400 shadow-[0_0_20px_rgba(244,63,94,0.25)]",
    border: "border-rose-500/30",
    dot: "bg-rose-400"
  },
  emerald: {
    btn: "bg-emerald-950/70 hover:bg-emerald-900/80 text-emerald-200 border-emerald-500/50 hover:border-emerald-400 shadow-[0_0_20px_rgba(16,185,129,0.25)]",
    border: "border-emerald-500/30",
    dot: "bg-emerald-400"
  },
  zinc: {
    btn: "bg-zinc-900 hover:bg-zinc-800 text-zinc-200 border-zinc-700 hover:border-zinc-500",
    border: "border-zinc-700",
    dot: "bg-zinc-400"
  }
};

const theme = project.data.brandColor ? colorStyles[project.data.brandColor] || colorStyles.zinc : colorStyles.zinc;
---

<Layout 
  title={`${project.data.title} | Matheus Yared`}
  description={project.data.description}
  lang={lang}
>
  <Breadcrumbs 
    segments={[
      { label: t('crumbs.projects'), href: `/${lang}/projects` },
      { label: project.data.title }
    ]} 
    lang={lang}
  />
  
  <article class="mt-4 pb-16">
    <header class="mb-12 border-b border-zinc-800/60 pb-8">
      <div class="max-w-4xl">
        <div class="flex flex-wrap items-center gap-3 text-xs text-zinc-500 font-mono mb-4">
          <time datetime={project.data.date.toISOString()}>
            {project.data.date.toLocaleDateString(lang === 'pt' ? 'pt-BR' : 'en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
          </time>
          {project.data.toolkit && (
            <>
              <span aria-hidden="true">&middot;</span>
              <span class="text-zinc-300 font-medium">{t('projects.toolkit_badge')}</span>
            </>
          )}
          {project.data.tags && project.data.tags.length > 0 && (
            <div class="flex flex-wrap gap-1.5 items-center">
              {project.data.tags.map((tag: string) => (
                <TechBadge tech={tag} />
              ))}
            </div>
          )}
        </div>
        
        <h1 class="text-3xl md:text-5xl font-sans font-semibold tracking-tight text-zinc-50 leading-tight">
          {project.data.title}
        </h1>
        
        <p class="mt-6 text-lg md:text-xl text-zinc-400 font-serif leading-relaxed">
          {project.data.description}
        </p>

        <!-- Tool and Repository Direct Action Buttons -->
        {(project.data.liveUrl || project.data.repoUrl) && (
          <div class="flex flex-wrap items-center gap-3.5 mt-8 pt-6 border-t border-zinc-800/40">
            {project.data.liveUrl && (
              <a 
                href={project.data.liveUrl}
                target="_blank"
                rel="noopener noreferrer"
                class={`inline-flex items-center gap-2 px-4 py-2.5 rounded text-xs font-mono font-medium border transition-all ${theme.btn}`}
              >
                <span class={`w-2 h-2 rounded-full ${theme.dot} animate-pulse`}></span>
                <span>{t('projects.open_tool_online')}</span>
                <span aria-hidden="true">&nearr;</span>
              </a>
            )}
            
            {project.data.repoUrl && (
              <a 
                href={project.data.repoUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 px-4 py-2.5 rounded text-xs font-mono text-zinc-300 hover:text-white bg-zinc-900/80 hover:bg-zinc-800 border border-zinc-800 hover:border-zinc-600 transition-colors"
              >
                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor">
                  <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
                </svg>
                <span>{t('projects.code_github')}</span>
                <span aria-hidden="true">&nearr;</span>
              </a>
            )}
          </div>
        )}
      </div>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-12 mb-16 pt-4 border-b border-zinc-800/60 pb-16">
      <div>
        <h4 class="text-xs font-mono text-amber-500/90 mb-2.5 uppercase tracking-wider">{t('projects.problem')}</h4>
        <p class="text-sm text-zinc-300 leading-relaxed font-sans">{project.data.problem}</p>
      </div>
      <div>
        <h4 class="text-xs font-mono text-zinc-400 mb-2.5 uppercase tracking-wider">{t('projects.solution')}</h4>
        <p class="text-sm text-zinc-300 leading-relaxed font-sans">{project.data.solution}</p>
      </div>
      <div>
        <h4 class="text-xs font-mono text-emerald-400/90 mb-2.5 uppercase tracking-wider">{t('projects.impact')}</h4>
        <p class="text-sm text-zinc-300 leading-relaxed font-sans">{project.data.impact}</p>
      </div>
    </div>
    
    <div class="mt-8 text-zinc-300 font-sans leading-relaxed mdx-content max-w-3xl">
      <Content />
    </div>
  </article>
</Layout>
